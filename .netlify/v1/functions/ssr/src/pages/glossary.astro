---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ContentSection from '../components/ContentSection.astro';

const glossaryTerms = [
  { term: 'Action', definition: 'A bet or wager. "Having action" means having money at risk on a game.' },
  { term: 'Against the Spread (ATS)', definition: 'Betting on whether a team will cover the point spread, rather than simply win the game.' },
  { term: 'Alternate Line', definition: 'A spread or total that differs from the primary line, offered at different odds.' },
  { term: 'Bankroll', definition: 'The total amount of money a bettor has set aside specifically for betting.' },
  { term: 'Bet Sizing', definition: 'The process of determining how much to wager on a single bet, typically as a percentage of bankroll.' },
  { term: 'Book / Sportsbook', definition: 'A company or establishment that accepts bets on sporting events.' },
  { term: 'Buying Points', definition: 'Paying extra juice to move a spread or total in your favor.' },
  { term: 'Chalk', definition: 'The favorite in a matchup. "Betting the chalk" means betting favorites.' },
  { term: 'Closing Line', definition: 'The final odds offered before an event begins. Used as a benchmark for measuring betting skill.' },
  { term: 'Closing Line Value (CLV)', definition: 'The difference between the odds you bet and the closing line. Consistently beating the close suggests long-term profitability.' },
  { term: 'Cover', definition: 'When a team wins by more than the spread (for favorites) or loses by less than the spread (for underdogs).' },
  { term: 'Dog / Underdog', definition: 'The team expected to lose, indicated by a + sign in American odds or receiving points on the spread.' },
  { term: 'Edge', definition: 'A bettor\'s advantage over the sportsbook, typically expressed as expected value.' },
  { term: 'Even Money', definition: 'A bet with no favorite, paying out at +100 (risk $100 to win $100).' },
  { term: 'Expected Value (EV)', definition: 'The average amount a bet would win or lose if placed many times. Positive EV (+EV) means long-term profit.' },
  { term: 'Favorite', definition: 'The team expected to win, indicated by a - sign in American odds or giving points on the spread.' },
  { term: 'Flat Betting', definition: 'Wagering the same amount on every bet regardless of confidence level.' },
  { term: 'Futures', definition: 'Bets on events that will be decided in the future, such as championship winners or season totals.' },
  { term: 'Handle', definition: 'The total amount of money wagered on an event or at a sportsbook.' },
  { term: 'Handicapper', definition: 'Someone who analyzes sporting events and makes predictions or betting recommendations.' },
  { term: 'Hedge', definition: 'Placing a bet on the opposite side of an existing bet to reduce risk or guarantee profit.' },
  { term: 'Hold', definition: 'The percentage of total money wagered that the sportsbook keeps as profit.' },
  { term: 'Hook', definition: 'A half-point in a spread. "-3.5" is "three and a hook."' },
  { term: 'Implied Probability', definition: 'The probability of an outcome as suggested by the betting odds.' },
  { term: 'In-Game / Live Betting', definition: 'Placing bets after an event has started, with odds that adjust in real-time.' },
  { term: 'Juice / Vig / Vigorish', definition: 'The commission charged by the sportsbook, built into the odds. Standard juice is -110.' },
  { term: 'Kelly Criterion', definition: 'A mathematical formula for optimal bet sizing based on edge size and bankroll.' },
  { term: 'Key Numbers', definition: 'Common final score margins in a sport. In NFL, 3 and 7 are key numbers.' },
  { term: 'Layoff', definition: 'When a sportsbook places a bet with another book to reduce its exposure on one side.' },
  { term: 'Limit', definition: 'The maximum amount a sportsbook will accept on a single bet.' },
  { term: 'Line', definition: 'The odds or point spread on a game. Also called the "number."' },
  { term: 'Line Movement', definition: 'Changes in odds or spreads between when a line opens and when the event begins.' },
  { term: 'Lock', definition: 'A bet perceived as certain to win. In reality, no bet is a lock.' },
  { term: 'Middle', definition: 'When line movement allows a bettor to win both sides of a bet. Betting Team A -3 and later Team B +5 creates a middle opportunity if the final margin is 4.' },
  { term: 'Moneyline', definition: 'A bet on which team will win straight-up, with no point spread involved.' },
  { term: 'Nickel', definition: 'A $500 bet.' },
  { term: 'No Action', definition: 'A bet that is cancelled and refunded, typically due to postponement or rule conditions not being met.' },
  { term: 'Odds', definition: 'The price offered by a sportsbook, representing both payout potential and implied probability.' },
  { term: 'Off the Board', definition: 'A game that the sportsbook is not currently accepting bets on.' },
  { term: 'Opening Line', definition: 'The first odds posted for an event before any betting occurs.' },
  { term: 'Over/Under', definition: 'See "Total."' },
  { term: 'Parlay', definition: 'A single bet combining multiple selections, all of which must win for the bet to pay out.' },
  { term: 'Pick / Pick\'em', definition: 'A game with no point spread, where both teams are considered equal.' },
  { term: 'Point Spread', definition: 'A handicap applied to the favorite to create a more even betting market.' },
  { term: 'Prop Bet / Proposition', definition: 'A bet on a specific occurrence within a game, not directly tied to the final outcome.' },
  { term: 'Public Money', definition: 'Bets from recreational bettors, often characterized by bias toward favorites and popular teams.' },
  { term: 'Push', definition: 'A tie against the spread or total, where the bet is refunded.' },
  { term: 'Reduced Juice', definition: 'Odds offered at lower than standard vig, such as -105 instead of -110.' },
  { term: 'Reverse Line Movement', definition: 'When a line moves in the opposite direction of where most bets are placed, suggesting sharp action.' },
  { term: 'ROI (Return on Investment)', definition: 'Profit or loss expressed as a percentage of total amount wagered.' },
  { term: 'Run Line', definition: 'A point spread in baseball, typically set at 1.5 runs.' },
  { term: 'Sharp', definition: 'A professional or highly skilled bettor whose action is respected by sportsbooks.' },
  { term: 'Sharp Money', definition: 'Bets from professional bettors, often characterized by larger amounts and early action.' },
  { term: 'Square', definition: 'A recreational bettor who bets for entertainment rather than profit.' },
  { term: 'Steam', definition: 'Rapid, significant line movement caused by heavy betting action.' },
  { term: 'Straight Bet', definition: 'A single wager on one selection, as opposed to a parlay.' },
  { term: 'Teaser', definition: 'A parlay where the bettor receives additional points on each selection in exchange for lower payouts.' },
  { term: 'Ticket', definition: 'A bet slip or wager confirmation.' },
  { term: 'Total', definition: 'A bet on whether the combined score of both teams will be over or under a specified number.' },
  { term: 'Tout', definition: 'Someone who sells betting picks or predictions, often with exaggerated claims.' },
  { term: 'Unit', definition: 'A standardized bet size, typically 1% of bankroll, used to track betting performance consistently.' },
  { term: 'Value', definition: 'When the odds offered are better than the true probability of an outcome.' },
  { term: 'Variance', definition: 'The natural fluctuation in results over time, even when making good bets.' },
  { term: 'Wager', definition: 'A bet.' },
  { term: 'Whale', definition: 'A bettor who places very large bets.' },
  { term: 'Wiseguy', definition: 'Another term for a sharp or professional bettor.' },
];

const alphabet = [...new Set(glossaryTerms.map(t => t.term[0].toUpperCase()))].sort();
---

<Layout
  title="Sports Betting Glossary"
  description="Comprehensive glossary of sports betting terms and definitions. Learn the language of betting markets, odds, and wagering."
>
  <Hero
    title="Sports Betting Glossary"
    subtitle="Clear Definitions for Every Betting Term You Need to Know"
    size="medium"
  />

  <div class="container content-container">
    <article class="page-content">
      <ContentSection>
        <div class="quick-take">
          <h2>Quick Take</h2>
          <p>
            Sports betting has its own vocabulary. Understanding these terms is essential for following betting discussions, reading odds, and communicating with sportsbooks. This glossary covers the most common and important terms you'll encounter, with clear definitions and context for how each term is used.
          </p>
        </div>
      </ContentSection>

      <nav class="alphabet-nav">
        {alphabet.map((letter) => (
          <a href={`#letter-${letter}`} class="alphabet-link">{letter}</a>
        ))}
      </nav>

      <div class="glossary-content">
        {alphabet.map((letter) => (
          <section id={`letter-${letter}`} class="letter-section">
            <h2 class="letter-heading">{letter}</h2>
            <dl class="terms-list">
              {glossaryTerms
                .filter(t => t.term[0].toUpperCase() === letter)
                .map((item) => (
                  <div class="term-entry">
                    <dt>{item.term}</dt>
                    <dd>{item.definition}</dd>
                  </div>
                ))
              }
            </dl>
          </section>
        ))}
      </div>

      <ContentSection title="What This Means for Bettors" id="what-means">
        <p>
          Knowing betting terminology helps you navigate sportsbooks confidently, understand analysis and commentary, and communicate clearly about your bets. More importantly, understanding concepts like expected value, closing line value, and variance helps you think about betting more rigorously.
        </p>
        <p>
          Don't just memorize definitions—understand how these concepts connect. The vig affects your break-even rate. Line movement reflects market information. Bankroll management protects you from variance. These relationships matter more than isolated terms.
        </p>
      </ContentSection>

      <ContentSection title="Key Takeaways" id="takeaways">
        <ul>
          <li>Learn foundational terms first: odds, spread, total, juice, bankroll</li>
          <li>Understand EV and CLV—they're how skilled bettors measure success</li>
          <li>Recognize that betting vocabulary evolves—new terms emerge regularly</li>
          <li>Context matters—the same term can have different meanings in different situations</li>
          <li>Use this glossary as a reference, not a study guide</li>
        </ul>
      </ContentSection>
    </article>
  </div>
</Layout>

<style>
  .page-content {
    padding: var(--spacing-3xl) 0;
  }

  .quick-take {
    background-color: var(--color-surface);
    border-left: 4px solid var(--color-accent);
    padding: var(--spacing-lg);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    margin-bottom: var(--spacing-xl);
  }

  .quick-take h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin-bottom: var(--spacing-sm);
  }

  .quick-take p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .alphabet-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    padding: var(--spacing-md);
    background-color: var(--color-surface);
    border-radius: var(--border-radius);
    margin-bottom: var(--spacing-2xl);
    position: sticky;
    top: 72px;
    z-index: 10;
  }

  .alphabet-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--border-radius);
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 600;
    transition: background-color var(--transition), color var(--transition);
  }

  .alphabet-link:hover {
    background-color: var(--color-accent-muted);
    color: var(--color-text);
  }

  .glossary-content {
    max-width: var(--max-width-content);
  }

  .letter-section {
    margin-bottom: var(--spacing-2xl);
    scroll-margin-top: 140px;
  }

  .letter-heading {
    font-size: 2rem;
    color: var(--color-accent);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: var(--spacing-sm);
    margin-bottom: var(--spacing-lg);
  }

  .terms-list {
    margin: 0;
  }

  .term-entry {
    padding: var(--spacing-md) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .term-entry:last-child {
    border-bottom: none;
  }

  .term-entry dt {
    font-weight: 600;
    color: var(--color-text);
    font-size: 1.1rem;
    margin-bottom: var(--spacing-xs);
  }

  .term-entry dd {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .alphabet-nav {
      position: static;
    }

    .alphabet-link {
      width: 32px;
      height: 32px;
      font-size: 0.875rem;
    }
  }
</style>
