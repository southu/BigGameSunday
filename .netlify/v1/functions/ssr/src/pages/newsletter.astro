---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ContentSection from '../components/ContentSection.astro';
---

<Layout
  title="Newsletter - Weekly Betting Insights"
  description="Subscribe to BigGameSunday's weekly newsletter for betting education, market analysis, and strategic insights delivered to your inbox."
>
  <Hero
    title="Weekly Betting Insights"
    subtitle="Education and Analysis Delivered to Your Inbox"
    size="medium"
  />

  <div class="container content-container">
    <article class="page-content">
      <ContentSection>
        <div class="quick-take">
          <h2>What You'll Get</h2>
          <p>
            Weekly analysis of betting markets, educational content on betting strategy, and thoughtful perspectives on sports wagering—no picks, no hype, no guarantees. Just the kind of thinking that helps you make better decisions.
          </p>
        </div>
      </ContentSection>

      <div class="newsletter-signup">
        <h2>Subscribe to the Newsletter</h2>
        <p class="signup-description">
          Join readers who want to think more carefully about sports betting. We send one email per week during major sports seasons.
        </p>

        <form class="signup-form" action="#" method="post">
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="your@email.com" required />
          </div>
          <button type="submit" class="submit-button">Subscribe</button>
        </form>

        <p class="privacy-note">
          We respect your privacy. Unsubscribe anytime. No spam, no selling your email, no nonsense.
        </p>
      </div>

      <ContentSection title="What We Cover" id="coverage">
        <ul>
          <li><strong>Market analysis:</strong> How betting markets are moving and what it might mean</li>
          <li><strong>Educational content:</strong> Deep dives into betting concepts and strategy</li>
          <li><strong>Situational breakdowns:</strong> What to watch for in upcoming games</li>
          <li><strong>Common mistakes:</strong> Errors we see bettors making and how to avoid them</li>
          <li><strong>Resource recommendations:</strong> Tools and content we find valuable</li>
        </ul>
      </ContentSection>

      <ContentSection title="What We Don't Do" id="no-picks">
        <ul>
          <li>We don't sell picks or tout services</li>
          <li>We don't promise profits or guaranteed winners</li>
          <li>We don't use hype or pressure tactics</li>
          <li>We don't share your information with anyone</li>
        </ul>
        <p>
          BigGameSunday is about helping you think better, not telling you what to bet. Our newsletter reflects that philosophy.
        </p>
      </ContentSection>
    </article>
  </div>
</Layout>

<style>
  .page-content { padding: var(--spacing-3xl) 0; }

  .quick-take {
    background-color: var(--color-surface);
    border-left: 4px solid var(--color-accent);
    padding: var(--spacing-lg);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    margin-bottom: var(--spacing-2xl);
  }

  .quick-take h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin-bottom: var(--spacing-sm);
  }

  .quick-take p { margin: 0; color: var(--color-text-secondary); }

  .newsletter-signup {
    background-color: var(--color-surface);
    padding: var(--spacing-2xl);
    border-radius: var(--border-radius-lg);
    margin-bottom: var(--spacing-2xl);
    max-width: 500px;
  }

  .newsletter-signup h2 {
    margin-top: 0;
    margin-bottom: var(--spacing-sm);
  }

  .signup-description {
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-lg);
  }

  .signup-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .form-group label {
    font-weight: 500;
    font-size: 0.875rem;
  }

  .form-group input {
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-size: 1rem;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .submit-button {
    padding: var(--spacing-sm) var(--spacing-lg);
    background-color: var(--color-accent);
    color: white;
    border: none;
    border-radius: var(--border-radius);
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--transition);
  }

  .submit-button:hover {
    background-color: var(--color-accent-hover);
  }

  .privacy-note {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: var(--spacing-md);
    margin-bottom: 0;
  }
</style>
