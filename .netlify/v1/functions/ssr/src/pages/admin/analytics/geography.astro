---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getServerClient } from '../../../lib/supabase/server';

const supabase = getServerClient();

const url = new URL(Astro.request.url);
const range = url.searchParams.get('range') || '7d';

const now = new Date();
let startDate: Date;

switch (range) {
  case '1d':
    startDate = new Date(now.getTime() - 24 * 60 * 60 * 1000);
    break;
  case '30d':
    startDate = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
    break;
  case '90d':
    startDate = new Date(now.getTime() - 90 * 24 * 60 * 60 * 1000);
    break;
  default:
    startDate = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
}

const { data: visits } = await supabase
  .from('page_visits')
  .select('*')
  .gte('visited_at', startDate.toISOString());

const { data: sessions } = await supabase
  .from('sessions')
  .select('*')
  .gte('started_at', startDate.toISOString());

interface CountryMetrics {
  country: string;
  visits: number;
  uniqueVisitors: number;
  sessions: number;
  bounces: number;
  bounceRate: number;
  avgDuration: number;
  topLandingPages: { path: string; count: number }[];
}

const countryData: Record<string, CountryMetrics> = {};
const visitorsByCountry: Record<string, Set<string>> = {};
const landingPagesByCountry: Record<string, Record<string, number>> = {};

visits?.forEach(visit => {
  const country = visit.country || 'Unknown';

  if (!countryData[country]) {
    countryData[country] = {
      country,
      visits: 0,
      uniqueVisitors: 0,
      sessions: 0,
      bounces: 0,
      bounceRate: 0,
      avgDuration: 0,
      topLandingPages: []
    };
    visitorsByCountry[country] = new Set();
  }

  countryData[country].visits++;
  visitorsByCountry[country].add(visit.visitor_id);
});

sessions?.forEach(session => {
  const country = session.country || 'Unknown';

  if (!countryData[country]) {
    countryData[country] = {
      country,
      visits: 0,
      uniqueVisitors: 0,
      sessions: 0,
      bounces: 0,
      bounceRate: 0,
      avgDuration: 0,
      topLandingPages: []
    };
    visitorsByCountry[country] = new Set();
    landingPagesByCountry[country] = {};
  }

  countryData[country].sessions++;
  countryData[country].avgDuration += session.total_duration_seconds || 0;

  if (session.is_bounce) {
    countryData[country].bounces++;
  }

  if (session.landing_page) {
    if (!landingPagesByCountry[country]) {
      landingPagesByCountry[country] = {};
    }
    landingPagesByCountry[country][session.landing_page] =
      (landingPagesByCountry[country][session.landing_page] || 0) + 1;
  }
});

Object.keys(countryData).forEach(country => {
  const data = countryData[country];
  data.uniqueVisitors = visitorsByCountry[country]?.size || 0;
  data.bounceRate = data.sessions > 0 ? (data.bounces / data.sessions) * 100 : 0;
  data.avgDuration = data.sessions > 0 ? data.avgDuration / data.sessions : 0;

  const landingPages = landingPagesByCountry[country] || {};
  data.topLandingPages = Object.entries(landingPages)
    .map(([path, count]) => ({ path, count }))
    .sort((a, b) => b.count - a.count)
    .slice(0, 3);
});

const countries = Object.values(countryData)
  .sort((a, b) => b.visits - a.visits);

const totalVisits = countries.reduce((sum, c) => sum + c.visits, 0);
const totalSessions = countries.reduce((sum, c) => sum + c.sessions, 0);

const usData = countryData['United States'];
const usPercent = usData ? ((usData.visits / totalVisits) * 100).toFixed(1) : '0';

function formatDuration(seconds: number): string {
  if (seconds < 60) return `${Math.round(seconds)}s`;
  const mins = Math.floor(seconds / 60);
  const secs = Math.round(seconds % 60);
  return `${mins}m ${secs}s`;
}
---

<AdminLayout title="Geography" currentPath="/admin/analytics/geography">
  <div class="geography-page">
    <div class="filters">
      <div class="filter-group">
        <label>Date Range</label>
        <select id="range-select" class="filter-select">
          <option value="1d" selected={range === '1d'}>Last 24 hours</option>
          <option value="7d" selected={range === '7d'}>Last 7 days</option>
          <option value="30d" selected={range === '30d'}>Last 30 days</option>
          <option value="90d" selected={range === '90d'}>Last 90 days</option>
        </select>
      </div>
      <button id="apply-filters" class="filter-btn">Apply Filters</button>
    </div>

    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-label">Total Countries</div>
        <div class="stat-value">{countries.length}</div>
      </div>
      <div class="stat-card highlight">
        <div class="stat-label">US Traffic</div>
        <div class="stat-value">{usPercent}%</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Total Visits</div>
        <div class="stat-value">{totalVisits.toLocaleString()}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Total Sessions</div>
        <div class="stat-value">{totalSessions.toLocaleString()}</div>
      </div>
    </div>

    <div class="quick-filters">
      <a href="?range={range}&focus=US" class="quick-filter">United States</a>
      <a href="?range={range}&focus=UK" class="quick-filter">United Kingdom</a>
      <a href="?range={range}&focus=CA" class="quick-filter">Canada</a>
      <a href="?range={range}&focus=AU" class="quick-filter">Australia</a>
    </div>

    <div class="countries-table">
      <table class="data-table">
        <thead>
          <tr>
            <th>Country</th>
            <th>Visits</th>
            <th>Unique Visitors</th>
            <th>Sessions</th>
            <th>Bounce Rate</th>
            <th>Avg. Duration</th>
            <th>Top Landing Pages</th>
          </tr>
        </thead>
        <tbody>
          {countries.map(c => (
            <tr class={c.country === 'United States' ? 'highlight-row' : ''}>
              <td class="country-name">
                <span class="country-flag">{c.country === 'United States' ? '🇺🇸' : c.country === 'United Kingdom' ? '🇬🇧' : c.country === 'Canada' ? '🇨🇦' : c.country === 'Australia' ? '🇦🇺' : '🌍'}</span>
                {c.country}
              </td>
              <td>
                <span class="visit-count">{c.visits.toLocaleString()}</span>
                <span class="visit-percent">({((c.visits / totalVisits) * 100).toFixed(1)}%)</span>
              </td>
              <td>{c.uniqueVisitors.toLocaleString()}</td>
              <td>{c.sessions.toLocaleString()}</td>
              <td class={c.bounceRate > 70 ? 'high' : c.bounceRate > 50 ? 'medium' : 'low'}>
                {c.bounceRate.toFixed(1)}%
              </td>
              <td>{formatDuration(c.avgDuration)}</td>
              <td class="landing-pages-cell">
                {c.topLandingPages.length > 0 ? (
                  <div class="landing-pages-list">
                    {c.topLandingPages.map(lp => (
                      <span class="landing-page-tag" title={lp.path}>
                        {lp.path.length > 20 ? lp.path.slice(0, 20) + '...' : lp.path}
                        <span class="lp-count">({lp.count})</span>
                      </span>
                    ))}
                  </div>
                ) : '-'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  const rangeSelect = document.getElementById('range-select') as HTMLSelectElement;
  const applyBtn = document.getElementById('apply-filters');

  applyBtn?.addEventListener('click', () => {
    const params = new URLSearchParams();
    params.set('range', rangeSelect.value);
    window.location.href = `/admin/analytics/geography?${params.toString()}`;
  });
</script>

<style>
  .geography-page {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .filters {
    display: flex;
    gap: 16px;
    align-items: flex-end;
    flex-wrap: wrap;
    background: #16202a;
    padding: 16px 20px;
    border-radius: 12px;
    border: 1px solid #2f3336;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .filter-group label {
    font-size: 0.75rem;
    color: #71767b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-select {
    background: #0f1419;
    border: 1px solid #2f3336;
    border-radius: 6px;
    padding: 8px 12px;
    color: #e7e9ea;
    font-size: 0.875rem;
    min-width: 150px;
  }

  .filter-btn {
    background: #1d9bf0;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
  }

  .stat-card {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 12px;
    padding: 16px 20px;
  }

  .stat-card.highlight {
    border-color: #1d9bf0;
    background: rgba(29, 155, 240, 0.1);
  }

  .stat-label {
    font-size: 0.75rem;
    color: #71767b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: #e7e9ea;
  }

  .quick-filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .quick-filter {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 20px;
    padding: 8px 16px;
    color: #e7e9ea;
    text-decoration: none;
    font-size: 0.875rem;
    transition: all 0.15s ease;
  }

  .quick-filter:hover {
    background: rgba(29, 155, 240, 0.1);
    border-color: #1d9bf0;
    color: #1d9bf0;
  }

  .countries-table {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 12px;
    overflow: hidden;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
  }

  .data-table th,
  .data-table td {
    text-align: left;
    padding: 12px 16px;
    font-size: 0.875rem;
    border-bottom: 1px solid #2f3336;
  }

  .data-table th {
    background: #0f1419;
    color: #71767b;
    font-weight: 600;
    white-space: nowrap;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  .data-table tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .highlight-row {
    background: rgba(29, 155, 240, 0.05);
  }

  .highlight-row:hover {
    background: rgba(29, 155, 240, 0.08);
  }

  .country-name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
  }

  .country-flag {
    font-size: 1.25rem;
  }

  .visit-count {
    font-weight: 600;
    color: #1d9bf0;
  }

  .visit-percent {
    color: #71767b;
    font-size: 0.75rem;
    margin-left: 4px;
  }

  .high {
    color: #f4212e;
  }

  .medium {
    color: #ffad1f;
  }

  .low {
    color: #00ba7c;
  }

  .landing-pages-cell {
    max-width: 250px;
  }

  .landing-pages-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .landing-page-tag {
    background: #0f1419;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    max-width: 150px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lp-count {
    color: #71767b;
    margin-left: 4px;
  }

  @media (max-width: 1200px) {
    .countries-table {
      overflow-x: auto;
    }

    .data-table {
      min-width: 900px;
    }
  }
</style>
