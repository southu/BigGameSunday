---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ContentSection from '../../components/ContentSection.astro';
import Callout from '../../components/Callout.astro';
import LinkCard from '../../components/LinkCard.astro';

const relatedPages = [
  { title: 'NBA Betting Hub', href: '/nba-betting', description: 'Complete NBA guide' },
  { title: 'NBA Playoffs', href: '/nba/playoff-betting', description: 'Postseason wagering' },
  { title: 'Load Management', href: '/nba/load-management', description: 'Rest and scheduling effects' },
];
---

<Layout
  title="NBA Live Betting Guide"
  description="In-game betting for NBA games, quarter dynamics, foul trouble, rotation patterns, and when live wagering might provide opportunities."
>
  <Hero
    title="NBA Live Betting Guide"
    subtitle="In-Game Wagering Considerations for Professional Basketball"
    size="medium"
  />

  <div class="container content-container">
    <article class="page-content">
      <ContentSection>
        <div class="quick-take">
          <h2>Quick Take</h2>
          <p>
            NBA games feature high scoring, predictable rotation patterns, and frequent lead changes. Live betting markets are highly efficient due to the league's national profile and sophisticated bettor interest. Opportunities exist but are fleeting—market algorithms process information faster than human observation. The best approach is extreme selectivity and pre-planned scenarios rather than reactive betting.
          </p>
        </div>
      </ContentSection>

      <ContentSection title="What Makes NBA Live Betting Unique?" id="unique">
        <h3>High scoring and pace</h3>
        <p>
          NBA games average 220+ combined points. Scoring swings happen rapidly, and 15-point leads can evaporate in a quarter. Live lines adjust constantly.
        </p>

        <h3>Predictable rotations</h3>
        <p>
          NBA coaches use relatively consistent rotation patterns. Knowing when stars rest and when they return helps anticipate line movements.
        </p>

        <h3>Fourth quarter dynamics</h3>
        <p>
          Close games tighten in the fourth quarter as coaches shorten rotations and play their best lineups. Blowouts feature garbage time with different dynamics.
        </p>
      </ContentSection>

      <ContentSection title="What This Means for Bettors" id="what-means">
        <ul>
          <li><strong>Plan scenarios before the game:</strong> Know what situations would trigger a live bet.</li>
          <li><strong>Watch rotation patterns:</strong> Second-unit vs starter matchups affect game flow.</li>
          <li><strong>Respect market efficiency:</strong> NBA live markets are among the sharpest.</li>
          <li><strong>Avoid chasing:</strong> Don't try to recover pre-game losses with live bets.</li>
        </ul>
      </ContentSection>

      <ContentSection title="Common Misconceptions" id="misconceptions">
        <h3>"I can see momentum shifts before the market"</h3>
        <p>Algorithms process play-by-play data in milliseconds. Your momentum read is already priced in.</p>

        <h3>"A big lead means the favorite will cover"</h3>
        <p>NBA teams regularly blow 20-point leads. Early game leads don't guarantee covering adjusted spreads.</p>
      </ContentSection>

      <ContentSection title="Key Takeaways" id="takeaways">
        <ul>
          <li>NBA live markets are highly efficient due to volume and interest</li>
          <li>Plan live betting scenarios before games start</li>
          <li>Rotation patterns and quarter dynamics matter</li>
          <li>Be extremely selective—most games don't offer live value</li>
        </ul>
      </ContentSection>

      <ContentSection title="Related Resources" id="related">
        <div class="related-grid">
          {relatedPages.map((page) => (
            <LinkCard title={page.title} href={page.href} description={page.description} />
          ))}
        </div>
      </ContentSection>
    </article>
  </div>
</Layout>

<style>
  .page-content { padding: var(--spacing-3xl) 0; }
  .quick-take { background-color: var(--color-surface); border-left: 4px solid var(--color-accent); padding: var(--spacing-lg); border-radius: 0 var(--border-radius) var(--border-radius) 0; margin-bottom: var(--spacing-xl); }
  .quick-take h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-accent); margin-bottom: var(--spacing-sm); }
  .quick-take p { margin: 0; color: var(--color-text-secondary); }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-md); margin-top: var(--spacing-lg); }
  @media (max-width: 768px) { .related-grid { grid-template-columns: 1fr; } }
</style>
