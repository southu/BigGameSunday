---
import SportLayout from '../layouts/SportLayout.astro';
import ContentSection from '../components/ContentSection.astro';
import FeaturedImage from '../components/FeaturedImage.astro';

const topics = [
  { title: 'Betting Strategy', href: '/betting-strategy', description: 'Expected value and bankroll management basics' },
  { title: 'NFL Betting', href: '/nfl-betting', description: 'Compare with professional football markets' },
  { title: 'Big Games', href: '/big-games-tournaments', description: 'Bowl games and playoff betting' },
  { title: 'Sportsbooks', href: '/sportsbooks-odds', description: 'Shopping for the best CFB lines' },
];

const articles = [
  {
    title: 'NFL Key Numbers Explained',
    href: '/blog/nfl-key-numbers-explained',
    description: 'Understanding key numbers applies to college football too.',
    category: 'NFL',
    categoryHref: '/blog/category/nfl',
    image: 'https://images.pexels.com/photos/47730/the-ball-stadion-football-the-pitch-47730.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
  {
    title: 'Bankroll Management Fundamentals',
    href: '/blog/bankroll-management-fundamentals',
    description: 'Protect your bankroll during the long CFB season.',
    category: 'Strategy',
    categoryHref: '/blog/category/strategy',
    image: 'https://images.pexels.com/photos/6693661/pexels-photo-6693661.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
];
---

<SportLayout
  title="College Football Betting Strategies"
  description="Understand college football betting markets: large spreads, conference dynamics, bowl games, and how to approach CFB betting with discipline."
  subtitle="Navigating Volatile Markets, Large Spreads, and Bowl Season"
  introText="College football's 130+ FBS teams, massive talent gaps, and passionate fanbases create a betting market unlike any other. Spreads can stretch into the 30s or 40s, markets vary by conference, and bowl season brings unique dynamics. This guide covers how CFB betting works and where disciplined bettors may find opportunities."
  topics={topics}
  articles={articles}
  image="/images/college-football-betting-strategies.png"
>
  <ContentSection title="CFB Betting Landscape" id="landscape">
    <h3>Large Spreads</h3>
    <p>
      College football features spreads that would be unthinkable in professional sports. Lines of 30, 40, or even 50 points are common when powerhouses face lesser opponents. Understanding how to approach these mismatches—whether to bet them, fade them, or focus on totals—is a key skill.
    </p>

    <h3>Conference Dynamics</h3>
    <p>
      Each conference has its own style of play, officiating tendencies, and competitive balance. SEC games play differently than Big 12 shootouts or Big Ten ground battles. Recognizing these patterns helps inform spread and totals analysis.
    </p>

    <h3>Information Edges</h3>
    <p>
      With so many teams and games, the college football betting market has more inefficiencies than the NFL. Dedicated research into smaller programs, coaching changes, and roster turnover can uncover value that more casual bettors miss.
    </p>
  </ContentSection>

  <FeaturedImage
    src="https://images.pexels.com/photos/1618269/pexels-photo-1618269.jpeg?auto=compress&cs=tinysrgb&w=1200"
    alt="College football stadium packed with fans"
    caption="College football's passionate fanbases create unique market dynamics"
    position="center"
  />

  <ContentSection title="Seasonal Considerations" id="seasonal">
    <h3>Early Season</h3>
    <p>
      The first weeks of the college football season involve significant uncertainty. New starters, coaching changes, and scheme adjustments make early lines particularly soft. However, the limited sample size cuts both ways—overreacting to Week 1 results is a common mistake.
    </p>

    <h3>Conference Play</h3>
    <p>
      Once conference play begins, the sample size grows and trends become clearer. Rivalry games, divisional implications, and scheduling quirks create specific angles that reward attention to detail.
    </p>

    <h3>Bowl Season</h3>
    <p>
      Bowl games present a unique betting environment. Long layoffs, opt-outs from NFL-bound players, and varying levels of team motivation create a different analytical challenge. Understanding which factors matter most in bowl games is essential.
    </p>
  </ContentSection>
</SportLayout>
