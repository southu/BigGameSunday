{
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "framework": null,
  "crons": [
    {
      "path": "/api/public/hooks/autopilot",
      "schedule": "*/10 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.biggamesunday.com" }],
      "destination": "https://biggamesunday.com/$1",
      "permanent": true
    }
  ]
}
