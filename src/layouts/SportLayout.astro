---
import Layout from './Layout.astro';
import Hero from '../components/Hero.astro';
import ContentSection from '../components/ContentSection.astro';
import LinkCard from '../components/LinkCard.astro';
import ArticleCard from '../components/ArticleCard.astro';

interface RelatedTopic {
  title: string;
  href: string;
  description: string;
}

interface RelatedArticle {
  title: string;
  href: string;
  description: string;
  category: string;
  categoryHref: string;
  image?: string;
}

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  subtitle: string;
  introText: string;
  topics?: RelatedTopic[];
  articles?: RelatedArticle[];
  image?: string;
}

const {
  title,
  metaTitle,
  description,
  subtitle,
  introText,
  topics = [],
  articles = [],
  image,
} = Astro.props;
---

<Layout title={metaTitle || title} description={description}>
  <Hero
    title={title}
    subtitle={subtitle}
    size="medium"
    image={image}
  />

  <div class="container content-container">
    <article class="page-content">
      <ContentSection>
        <p set:html={introText} />
      </ContentSection>

      <slot />

      {topics.length > 0 && (
        <ContentSection title="Key Topics" id="topics">
          <div class="topics-grid">
            {topics.map((topic) => (
              <LinkCard
                title={topic.title}
                href={topic.href}
                description={topic.description}
              />
            ))}
          </div>
        </ContentSection>
      )}

      {articles.length > 0 && (
        <section class="related-articles">
          <div class="section-header">
            <h2>Latest Articles</h2>
            <a href="/blog" class="section-link">View all</a>
          </div>
          <div class="articles-grid">
            {articles.map((article) => (
              <ArticleCard
                title={article.title}
                href={article.href}
                description={article.description}
                category={article.category}
                categoryHref={article.categoryHref}
                image={article.image}
              />
            ))}
          </div>
        </section>
      )}
    </article>
  </div>
</Layout>

<style>
  .page-content {
    padding: var(--spacing-3xl) 0;
  }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
  }

  .related-articles {
    margin-top: var(--spacing-3xl);
    padding-top: var(--spacing-2xl);
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--spacing-xl);
  }

  .section-header h2 {
    margin: 0;
    font-size: 1.5rem;
  }

  .section-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }

  .section-link:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
  }

  @media (max-width: 768px) {
    .topics-grid,
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
