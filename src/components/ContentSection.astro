---
interface Props {
  title?: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<section class="content-section" id={id}>
  {title && <h2 class="content-section-title">{title}</h2>}
  <div class="content-section-body">
    <slot />
  </div>
</section>

<style>
  .content-section {
    margin-bottom: var(--spacing-3xl);
  }

  .content-section-title {
    font-size: 1.75rem;
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .content-section-body {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .content-section-body :global(h3) {
    color: var(--color-text);
    font-size: 1.35rem;
    margin-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-md);
  }

  .content-section-body :global(h4) {
    color: var(--color-text);
    font-size: 1.15rem;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  .content-section-body :global(p) {
    margin-bottom: var(--spacing-md);
  }

  .content-section-body :global(ul),
  .content-section-body :global(ol) {
    margin-bottom: var(--spacing-md);
  }

  .content-section-body :global(li) {
    margin-bottom: var(--spacing-xs);
  }

  .content-section-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .content-section-body :global(a:hover) {
    color: var(--color-accent-hover);
  }
</style>
