---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  position?: 'full' | 'left' | 'right' | 'center';
}

const { src, alt, caption, position = 'full' } = Astro.props;
---

<figure class={`featured-image featured-image--${position}`}>
  <img src={src} alt={alt} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .featured-image {
    margin: var(--spacing-xl) 0;
  }

  .featured-image img {
    width: 100%;
    height: auto;
    border-radius: var(--border-radius-lg);
    display: block;
  }

  .featured-image figcaption {
    margin-top: var(--spacing-sm);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-align: center;
    font-style: italic;
  }

  .featured-image--full {
    width: 100%;
  }

  .featured-image--center {
    max-width: 80%;
    margin-left: auto;
    margin-right: auto;
  }

  .featured-image--left {
    float: left;
    width: 45%;
    margin-right: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  .featured-image--right {
    float: right;
    width: 45%;
    margin-left: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  @media (max-width: 768px) {
    .featured-image--left,
    .featured-image--right {
      float: none;
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    .featured-image--center {
      max-width: 100%;
    }
  }
</style>
