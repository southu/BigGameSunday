---
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sign in — Big Game Sunday</title>
  </head>
  <body>
    <main class="wrap">
      <a class="brand" href="/">Big Game Sunday</a>
      <div class="card">
        <div class="tabs" role="tablist">
          <button type="button" id="tab-signup" data-mode="signup">New household</button>
          <button type="button" id="tab-signin" data-mode="signin">Sign in</button>
        </div>

        <form id="auth-form">
          <label>
            Parent's email
            <input id="email" type="email" required autocomplete="email" />
          </label>
          <label>
            Password
            <input id="password" type="password" required minlength="6" autocomplete="current-password" />
          </label>
          <p id="error" class="error" hidden></p>
          <p id="message" class="message" hidden></p>
          <button type="submit" id="submit">Sign in</button>
          <button type="button" id="forgot" class="linkish">Forgot password?</button>
        </form>

        <div class="or"><span></span>OR<span></span></div>
        <button type="button" id="google">Continue with Google</button>
        <p class="fine">Only the parent account uses an email. Kids' profiles are just a name and an avatar.</p>
      </div>
    </main>

    <script>
      import {
        createParentAuthClient,
        googleRedirectTo,
        resetPasswordForEmail,
        signInWithGoogle,
        signInWithPassword,
        signUpWithPassword,
      } from "../lib/auth/parent";

      const params = new URLSearchParams(window.location.search);
      const next = params.get("next") === "/ops" ? "/ops" : "/";
      let mode: "signin" | "signup" = next === "/ops" ? "signin" : "signup";

      const emailInput = document.getElementById("email") as HTMLInputElement;
      const passwordInput = document.getElementById("password") as HTMLInputElement;
      const submit = document.getElementById("submit") as HTMLButtonElement;
      const errorEl = document.getElementById("error") as HTMLParagraphElement;
      const messageEl = document.getElementById("message") as HTMLParagraphElement;
      const tabSignin = document.getElementById("tab-signin") as HTMLButtonElement;
      const tabSignup = document.getElementById("tab-signup") as HTMLButtonElement;

      function setBusy(busy: boolean) {
        submit.disabled = busy;
        (document.getElementById("google") as HTMLButtonElement).disabled = busy;
        (document.getElementById("forgot") as HTMLButtonElement).disabled = busy;
      }

      function showError(text: string | null) {
        errorEl.hidden = !text;
        errorEl.textContent = text ?? "";
      }

      function showMessage(text: string | null) {
        messageEl.hidden = !text;
        messageEl.textContent = text ?? "";
      }

      function renderMode() {
        tabSignin.classList.toggle("active", mode === "signin");
        tabSignup.classList.toggle("active", mode === "signup");
        submit.textContent = mode === "signup" ? "Create household account" : "Sign in";
      }

      function client() {
        return createParentAuthClient();
      }

      async function redirectIfSignedIn() {
        try {
          const { data } = await client().auth.getSession();
          if (data.session) window.location.replace(next);
        } catch {
          showError("Missing Supabase environment variables");
        }
      }

      tabSignin.addEventListener("click", () => {
        mode = "signin";
        renderMode();
      });
      tabSignup.addEventListener("click", () => {
        mode = "signup";
        renderMode();
      });

      document.getElementById("auth-form")!.addEventListener("submit", async (event) => {
        event.preventDefault();
        setBusy(true);
        showError(null);
        showMessage(null);
        try {
          const email = emailInput.value.trim();
          const password = passwordInput.value;
          if (mode === "signup") {
            const { data, error } = await signUpWithPassword(
              client(),
              email,
              password,
              window.location.origin,
            );
            if (error) throw error;
            if (!data.session) {
              showMessage("Check your email to confirm your account, then come back and sign in.");
              return;
            }
            window.location.replace(next);
            return;
          }
          const { error } = await signInWithPassword(client(), email, password);
          if (error) throw error;
          window.location.replace(next);
        } catch (err) {
          showError(err instanceof Error ? err.message : "Something went wrong.");
        } finally {
          setBusy(false);
        }
      });

      document.getElementById("google")!.addEventListener("click", async () => {
        showError(null);
        const { error } = await signInWithGoogle(
          client(),
          googleRedirectTo(window.location.origin, next === "/ops" ? "/ops" : null),
        );
        if (error) showError("Google sign-in didn't work. Try email instead.");
      });

      document.getElementById("forgot")!.addEventListener("click", async () => {
        setBusy(true);
        showError(null);
        showMessage(null);
        try {
          const email = emailInput.value.trim();
          if (!email) {
            showError("Enter your email first.");
            return;
          }
          const { error } = await resetPasswordForEmail(
            client(),
            email,
            "https://www.biggamesunday.com/auth",
          );
          if (error) throw error;
          showMessage("If that email is registered, a reset link is on the way. Check your inbox.");
        } catch (err) {
          showError(err instanceof Error ? err.message : "Something went wrong.");
        } finally {
          setBusy(false);
        }
      });

      renderMode();
      void redirectIfSignedIn();
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: Inter, system-ui, sans-serif;
    background: #0f1419;
    color: #e7e9ea;
  }
  .wrap {
    width: min(28rem, calc(100% - 2rem));
    padding: 2.5rem 0;
  }
  .brand {
    display: block;
    text-align: center;
    color: inherit;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .card {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 1.5rem;
    padding: 1.5rem;
  }
  .tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    background: #0f1419;
    border-radius: 9999px;
    padding: 0.25rem;
  }
  .tabs button {
    border: 0;
    background: transparent;
    color: #8b98a5;
    border-radius: 9999px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-weight: 700;
  }
  .tabs button.active {
    background: #1d9bf0;
    color: #fff;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
  input {
    background: #0f1419;
    border: 1px solid #2f3336;
    border-radius: 1rem;
    padding: 0.75rem 1rem;
    color: inherit;
    font: inherit;
  }
  button[type="submit"],
  #google {
    width: 100%;
    border: 0;
    border-radius: 9999px;
    padding: 0.9rem 1.5rem;
    font-weight: 700;
    cursor: pointer;
  }
  button[type="submit"] {
    background: #1d9bf0;
    color: #fff;
  }
  #google {
    background: #0f1419;
    color: inherit;
    border: 1px solid #2f3336;
  }
  .linkish {
    border: 0;
    background: transparent;
    color: #8b98a5;
    cursor: pointer;
    font-weight: 700;
  }
  .or {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1rem 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: #8b98a5;
  }
  .or span {
    flex: 1;
    height: 1px;
    background: #2f3336;
  }
  .error {
    color: #f4212e;
    font-weight: 700;
    font-size: 0.875rem;
  }
  .message {
    color: #00ba7c;
    font-weight: 700;
    font-size: 0.875rem;
  }
  .fine {
    margin: 1.25rem 0 0;
    text-align: center;
    font-size: 0.75rem;
    color: #8b98a5;
  }
  button:disabled {
    opacity: 0.5;
  }
</style>
