---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getServerClient } from '../../../lib/supabase/server';

const supabase = getServerClient();

const { data: pages, count: pageCount } = await supabase
  .from('pages')
  .select('*', { count: 'exact' })
  .order('path');

const { data: internalLinks, count: internalCount } = await supabase
  .from('internal_links')
  .select('*', { count: 'exact' });

const { data: externalLinks, count: externalCount } = await supabase
  .from('external_links')
  .select('*', { count: 'exact' });

const brokenInternalLinks = internalLinks?.filter(l => !l.is_valid) || [];
const brokenExternalLinks = externalLinks?.filter(l => !l.is_valid) || [];

const { data: recentBuilds } = await supabase
  .from('build_logs')
  .select('*')
  .order('started_at', { ascending: false })
  .limit(5);

const lastBuild = recentBuilds?.[0];
const lastBuildSuccess = lastBuild?.status === 'success';

const healthScore = Math.round(
  (brokenInternalLinks.length === 0 ? 40 : 0) +
  (brokenExternalLinks.length < 5 ? 30 : brokenExternalLinks.length < 10 ? 15 : 0) +
  (lastBuildSuccess ? 30 : 0)
);

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true
  });
}
---

<AdminLayout title="Site Health" currentPath="/admin/health">
  <div class="health-page">
    <div class="health-score-card">
      <div class="score-circle" data-score={healthScore}>
        <svg viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="45" fill="none" stroke="#2f3336" stroke-width="8" />
          <circle
            cx="50"
            cy="50"
            r="45"
            fill="none"
            stroke={healthScore >= 80 ? '#00ba7c' : healthScore >= 50 ? '#ffad1f' : '#f4212e'}
            stroke-width="8"
            stroke-linecap="round"
            stroke-dasharray={`${healthScore * 2.83} 283`}
            transform="rotate(-90 50 50)"
          />
        </svg>
        <span class="score-value">{healthScore}</span>
      </div>
      <div class="score-info">
        <h2>Health Score</h2>
        <p class={healthScore >= 80 ? 'good' : healthScore >= 50 ? 'medium' : 'bad'}>
          {healthScore >= 80 ? 'Excellent' : healthScore >= 50 ? 'Fair' : 'Needs Attention'}
        </p>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon">📄</div>
        <div class="stat-content">
          <div class="stat-value">{pageCount || 0}</div>
          <div class="stat-label">Pages Indexed</div>
        </div>
              </div>

      <div class="stat-card">
        <div class="stat-icon">🔗</div>
        <div class="stat-content">
          <div class="stat-value">{internalCount || 0}</div>
          <div class="stat-label">Internal Links</div>
        </div>
        <a href="/admin/health/links?type=internal" class="stat-link">View</a>
      </div>

      <div class="stat-card">
        <div class="stat-icon">🌐</div>
        <div class="stat-content">
          <div class="stat-value">{externalCount || 0}</div>
          <div class="stat-label">External Links</div>
        </div>
        <a href="/admin/health/links?type=external" class="stat-link">View</a>
      </div>

      <div class={`stat-card ${brokenInternalLinks.length > 0 || brokenExternalLinks.length > 0 ? 'warning' : ''}`}>
        <div class="stat-icon">⚠️</div>
        <div class="stat-content">
          <div class="stat-value">{brokenInternalLinks.length + brokenExternalLinks.length}</div>
          <div class="stat-label">Broken Links</div>
        </div>
        <a href="/admin/health/links?status=broken" class="stat-link">View</a>
      </div>
    </div>

    <div class="content-grid">
      <div class="panel">
        <div class="panel-header">
          <h3>Broken Links</h3>
          <a href="/admin/health/links?status=broken" class="view-all">View all</a>
        </div>
        <div class="panel-content">
          {brokenInternalLinks.length === 0 && brokenExternalLinks.length === 0 ? (
            <div class="success-message">
              <span class="success-icon">✓</span>
              No broken links found
            </div>
          ) : (
            <div class="broken-links-list">
              {brokenInternalLinks.slice(0, 5).map(link => (
                <div class="broken-link-item">
                  <span class="link-type internal">Internal</span>
                  <div class="link-info">
                    <span class="link-url">{link.target_page}</span>
                    <span class="link-source">from {link.source_page}</span>
                  </div>
                </div>
              ))}
              {brokenExternalLinks.slice(0, 5).map(link => (
                <div class="broken-link-item">
                  <span class="link-type external">External</span>
                  <div class="link-info">
                    <span class="link-url">{link.url}</span>
                    <span class="link-source">from {link.source_page}</span>
                    {link.error_message && (
                      <span class="link-error">{link.error_message}</span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      <div class="panel">
        <div class="panel-header">
          <h3>Recent Builds</h3>
          <a href="/admin/health/builds" class="view-all">View all</a>
        </div>
        <div class="panel-content">
          {recentBuilds && recentBuilds.length > 0 ? (
            <div class="builds-list">
              {recentBuilds.map(build => (
                <div class="build-item">
                  <span class={`build-status ${build.status}`}>
                    {build.status === 'success' ? '✓' : build.status === 'failed' ? '✗' : '○'}
                  </span>
                  <div class="build-info">
                    <span class="build-date">{formatDate(build.started_at)}</span>
                    <span class="build-stats">
                      {build.page_count} pages · {build.duration_ms ? `${(build.duration_ms / 1000).toFixed(1)}s` : '-'}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="empty-state">No builds recorded yet</div>
          )}
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .health-page {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .health-score-card {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 12px;
    padding: 24px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .score-circle {
    width: 100px;
    height: 100px;
    position: relative;
  }

  .score-circle svg {
    width: 100%;
    height: 100%;
  }

  .score-value {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.75rem;
    font-weight: 700;
  }

  .score-info h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .score-info p {
    font-size: 1rem;
    font-weight: 500;
  }

  .score-info p.good {
    color: #00ba7c;
  }

  .score-info p.medium {
    color: #ffad1f;
  }

  .score-info p.bad {
    color: #f4212e;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .stat-card {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 12px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .stat-card.warning {
    border-color: #ffad1f;
    background: rgba(255, 173, 31, 0.05);
  }

  .stat-icon {
    font-size: 1.5rem;
  }

  .stat-content {
    flex: 1;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .stat-label {
    font-size: 0.8125rem;
    color: #71767b;
  }

  .stat-link {
    color: #1d9bf0;
    text-decoration: none;
    font-size: 0.875rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 24px;
  }

  .panel {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 12px;
    overflow: hidden;
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid #2f3336;
  }

  .panel-header h3 {
    font-size: 1rem;
    font-weight: 600;
  }

  .view-all {
    color: #1d9bf0;
    text-decoration: none;
    font-size: 0.875rem;
  }

  .panel-content {
    padding: 16px 20px;
  }

  .success-message {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #00ba7c;
    font-size: 0.9375rem;
  }

  .success-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(0, 186, 124, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .broken-links-list,
  .builds-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .broken-link-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .link-type {
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .link-type.internal {
    background: rgba(29, 155, 240, 0.1);
    color: #1d9bf0;
  }

  .link-type.external {
    background: rgba(255, 173, 31, 0.1);
    color: #ffad1f;
  }

  .link-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .link-url {
    font-size: 0.875rem;
    word-break: break-all;
  }

  .link-source {
    font-size: 0.75rem;
    color: #71767b;
  }

  .link-error {
    font-size: 0.75rem;
    color: #f4212e;
  }

  .build-item {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .build-status {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .build-status.success {
    background: rgba(0, 186, 124, 0.1);
    color: #00ba7c;
  }

  .build-status.failed {
    background: rgba(244, 33, 46, 0.1);
    color: #f4212e;
  }

  .build-status.running {
    background: rgba(29, 155, 240, 0.1);
    color: #1d9bf0;
  }

  .build-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .build-date {
    font-size: 0.875rem;
  }

  .build-stats {
    font-size: 0.75rem;
    color: #71767b;
  }

  .empty-state {
    color: #71767b;
    font-size: 0.875rem;
    text-align: center;
    padding: 20px;
  }
</style>
