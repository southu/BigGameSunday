---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getServerClient } from '../../../lib/supabase/server';

const supabase = getServerClient();

const url = new URL(Astro.request.url);
const page = parseInt(url.searchParams.get('page') || '1');
const perPage = 20;

const { data: builds, count: totalCount } = await supabase
  .from('build_logs')
  .select('*', { count: 'exact' })
  .order('started_at', { ascending: false })
  .range((page - 1) * perPage, page * perPage - 1);

const totalPages = Math.ceil((totalCount || 0) / perPage);

const successfulBuilds = builds?.filter(b => b.status === 'success').length || 0;
const failedBuilds = builds?.filter(b => b.status === 'failed').length || 0;
const avgDuration = builds?.length
  ? builds.reduce((sum, b) => sum + (b.duration_ms || 0), 0) / builds.length
  : 0;

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true
  });
}

function formatDuration(ms: number | null): string {
  if (!ms) return '-';
  if (ms < 1000) return `${ms}ms`;
  const seconds = ms / 1000;
  if (seconds < 60) return `${seconds.toFixed(1)}s`;
  const minutes = Math.floor(seconds / 60);
  const remainingSecs = Math.round(seconds % 60);
  return `${minutes}m ${remainingSecs}s`;
}
---

<AdminLayout title="Builds" currentPath="/admin/health/builds">
  <div class="builds-page">
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-label">Total Builds</div>
        <div class="stat-value">{totalCount || 0}</div>
      </div>
      <div class="stat-card success">
        <div class="stat-label">Successful</div>
        <div class="stat-value">{successfulBuilds}</div>
      </div>
      <div class="stat-card error">
        <div class="stat-label">Failed</div>
        <div class="stat-value">{failedBuilds}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Avg Duration</div>
        <div class="stat-value">{formatDuration(avgDuration)}</div>
      </div>
    </div>

    <div class="builds-list">
      {builds && builds.length > 0 ? (
        builds.map(build => (
          <details class="build-card">
            <summary class="build-summary">
              <span class={`status-indicator ${build.status}`}>
                {build.status === 'success' ? '✓' : build.status === 'failed' ? '✗' : '○'}
              </span>
              <div class="build-main">
                <span class="build-date">{formatDate(build.started_at)}</span>
                <span class={`build-status ${build.status}`}>{build.status}</span>
              </div>
              <div class="build-stats">
                <span class="stat">{build.page_count || 0} pages</span>
                <span class="stat">{formatDuration(build.duration_ms)}</span>
                {(build.error_count || 0) > 0 && (
                  <span class="stat error">{build.error_count} errors</span>
                )}
                {(build.warning_count || 0) > 0 && (
                  <span class="stat warning">{build.warning_count} warnings</span>
                )}
              </div>
            </summary>
            <div class="build-details">
              <div class="detail-grid">
                <div class="detail-item">
                  <span class="detail-label">Build ID</span>
                  <span class="detail-value mono">{build.build_id}</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Started</span>
                  <span class="detail-value">{formatDate(build.started_at)}</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Ended</span>
                  <span class="detail-value">{build.ended_at ? formatDate(build.ended_at) : '-'}</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Duration</span>
                  <span class="detail-value">{formatDuration(build.duration_ms)}</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Pages</span>
                  <span class="detail-value">{build.page_count || 0}</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Internal Links</span>
                  <span class="detail-value">{build.internal_link_count || 0}</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">External Links</span>
                  <span class="detail-value">{build.external_link_count || 0}</span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Broken Links</span>
                  <span class={`detail-value ${(build.broken_link_count || 0) > 0 ? 'error' : ''}`}>
                    {build.broken_link_count || 0}
                  </span>
                </div>
              </div>

              {build.errors && Array.isArray(build.errors) && build.errors.length > 0 && (
                <div class="errors-section">
                  <h4>Errors</h4>
                  <div class="error-list">
                    {build.errors.map((error: any) => (
                      <div class="error-item">
                        <span class="error-icon">✗</span>
                        <span class="error-message">{typeof error === 'string' ? error : JSON.stringify(error)}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {build.warnings && Array.isArray(build.warnings) && build.warnings.length > 0 && (
                <div class="warnings-section">
                  <h4>Warnings</h4>
                  <div class="warning-list">
                    {build.warnings.map((warning: any) => (
                      <div class="warning-item">
                        <span class="warning-icon">⚠</span>
                        <span class="warning-message">{typeof warning === 'string' ? warning : JSON.stringify(warning)}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </details>
        ))
      ) : (
        <div class="empty-state">
          <p>No builds recorded yet</p>
          <p class="hint">Builds will be logged automatically when you run the build command</p>
        </div>
      )}
    </div>

    {totalPages > 1 && (
      <div class="pagination">
        {page > 1 && (
          <a href={`?page=${page - 1}`} class="page-btn">Previous</a>
        )}
        <span class="page-info">Page {page} of {totalPages}</span>
        {page < totalPages && (
          <a href={`?page=${page + 1}`} class="page-btn">Next</a>
        )}
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .builds-page {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
  }

  .stat-card {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 12px;
    padding: 16px 20px;
  }

  .stat-card.success {
    border-color: #00ba7c;
    background: rgba(0, 186, 124, 0.05);
  }

  .stat-card.error {
    border-color: #f4212e;
    background: rgba(244, 33, 46, 0.05);
  }

  .stat-label {
    font-size: 0.75rem;
    color: #71767b;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .builds-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .build-card {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 12px;
    overflow: hidden;
  }

  .build-summary {
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .build-summary::-webkit-details-marker {
    display: none;
  }

  .status-indicator {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .status-indicator.success {
    background: rgba(0, 186, 124, 0.1);
    color: #00ba7c;
  }

  .status-indicator.failed {
    background: rgba(244, 33, 46, 0.1);
    color: #f4212e;
  }

  .status-indicator.running {
    background: rgba(29, 155, 240, 0.1);
    color: #1d9bf0;
  }

  .build-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .build-date {
    font-weight: 500;
  }

  .build-status {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 600;
  }

  .build-status.success {
    color: #00ba7c;
  }

  .build-status.failed {
    color: #f4212e;
  }

  .build-status.running {
    color: #1d9bf0;
  }

  .build-stats {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .build-stats .stat {
    font-size: 0.875rem;
    color: #71767b;
  }

  .build-stats .stat.error {
    color: #f4212e;
  }

  .build-stats .stat.warning {
    color: #ffad1f;
  }

  .build-details {
    padding: 20px;
    border-top: 1px solid #2f3336;
    background: #0f1419;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
    margin-bottom: 20px;
  }

  .detail-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .detail-label {
    font-size: 0.75rem;
    color: #71767b;
  }

  .detail-value {
    font-size: 0.875rem;
  }

  .detail-value.mono {
    font-family: monospace;
    font-size: 0.75rem;
    word-break: break-all;
  }

  .detail-value.error {
    color: #f4212e;
  }

  .errors-section,
  .warnings-section {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid #2f3336;
  }

  .errors-section h4,
  .warnings-section h4 {
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .errors-section h4 {
    color: #f4212e;
  }

  .warnings-section h4 {
    color: #ffad1f;
  }

  .error-list,
  .warning-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .error-item,
  .warning-item {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 0.8125rem;
  }

  .error-icon {
    color: #f4212e;
  }

  .warning-icon {
    color: #ffad1f;
  }

  .error-message,
  .warning-message {
    word-break: break-all;
  }

  .empty-state {
    text-align: center;
    color: #71767b;
    padding: 60px 20px;
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 12px;
  }

  .empty-state .hint {
    font-size: 0.8125rem;
    margin-top: 8px;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }

  .page-btn {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 6px;
    padding: 8px 16px;
    color: #e7e9ea;
    text-decoration: none;
    font-size: 0.875rem;
  }

  .page-btn:hover {
    background: rgba(29, 155, 240, 0.1);
    border-color: #1d9bf0;
    color: #1d9bf0;
  }

  .page-info {
    color: #71767b;
    font-size: 0.875rem;
  }
</style>
