---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getServerClient } from '../../../lib/supabase/server';

const supabase = getServerClient();

const url = new URL(Astro.request.url);
const range = url.searchParams.get('range') || '7d';
const country = url.searchParams.get('country') || 'US';

const now = new Date();
let startDate: Date;

switch (range) {
  case '1d':
    startDate = new Date(now.getTime() - 24 * 60 * 60 * 1000);
    break;
  case '30d':
    startDate = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
    break;
  case '90d':
    startDate = new Date(now.getTime() - 90 * 24 * 60 * 60 * 1000);
    break;
  default:
    startDate = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
}

let visitsQuery = supabase
  .from('page_visits')
  .select('*')
  .gte('visited_at', startDate.toISOString());

let sessionsQuery = supabase
  .from('sessions')
  .select('*')
  .gte('started_at', startDate.toISOString());

if (country !== 'all') {
  visitsQuery = visitsQuery.eq('country', country === 'US' ? 'United States' : country);
  sessionsQuery = sessionsQuery.eq('country', country === 'US' ? 'United States' : country);
}

const { data: visits } = await visitsQuery;
const { data: sessions } = await sessionsQuery;

const totalVisits = visits?.length || 0;
const uniqueVisitors = new Set(visits?.map(v => v.visitor_id)).size;
const totalSessions = sessions?.length || 0;

const avgPagesPerSession = totalSessions > 0
  ? (sessions?.reduce((sum, s) => sum + (s.page_count || 0), 0) || 0) / totalSessions
  : 0;

const bouncedSessions = sessions?.filter(s => s.is_bounce).length || 0;
const bounceRate = totalSessions > 0 ? (bouncedSessions / totalSessions) * 100 : 0;

const avgTimeOnSite = totalSessions > 0
  ? (sessions?.reduce((sum, s) => sum + (s.total_duration_seconds || 0), 0) || 0) / totalSessions
  : 0;

const visitsByPage: Record<string, number> = {};
visits?.forEach(v => {
  visitsByPage[v.page_path] = (visitsByPage[v.page_path] || 0) + 1;
});

const topPages = Object.entries(visitsByPage)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 20);

const visitsByDevice: Record<string, number> = {};
visits?.forEach(v => {
  const device = v.device_type || 'unknown';
  visitsByDevice[device] = (visitsByDevice[device] || 0) + 1;
});

const visitsByBrowser: Record<string, number> = {};
visits?.forEach(v => {
  const browser = v.browser || 'unknown';
  visitsByBrowser[browser] = (visitsByBrowser[browser] || 0) + 1;
});

const visitsByDay: Record<string, number> = {};
visits?.forEach(v => {
  const day = v.visited_at.split('T')[0];
  visitsByDay[day] = (visitsByDay[day] || 0) + 1;
});

const chartData = Object.entries(visitsByDay)
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([date, count]) => ({ date, count }));

const { data: countries } = await supabase
  .from('page_visits')
  .select('country')
  .gte('visited_at', startDate.toISOString());

const countrySet = new Set(countries?.map(c => c.country).filter(Boolean));
const availableCountries = Array.from(countrySet).sort();

function formatDuration(seconds: number): string {
  if (seconds < 60) return `${Math.round(seconds)}s`;
  const mins = Math.floor(seconds / 60);
  const secs = Math.round(seconds % 60);
  return `${mins}m ${secs}s`;
}
---

<AdminLayout title="Analytics" currentPath="/admin/analytics">
  <div class="analytics-page">
    <div class="filters">
      <div class="filter-group">
        <label>Date Range</label>
        <select id="range-select" class="filter-select">
          <option value="1d" selected={range === '1d'}>Last 24 hours</option>
          <option value="7d" selected={range === '7d'}>Last 7 days</option>
          <option value="30d" selected={range === '30d'}>Last 30 days</option>
          <option value="90d" selected={range === '90d'}>Last 90 days</option>
        </select>
      </div>
      <div class="filter-group">
        <label>Country</label>
        <select id="country-select" class="filter-select">
          <option value="all" selected={country === 'all'}>All Countries</option>
          <option value="US" selected={country === 'US'}>United States</option>
          {availableCountries.filter(c => c !== 'United States').map(c => (
            <option value={c} selected={country === c}>{c}</option>
          ))}
        </select>
      </div>
      <button id="apply-filters" class="filter-btn">Apply Filters</button>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Total Visits</div>
        <div class="stat-value">{totalVisits.toLocaleString()}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Unique Visitors</div>
        <div class="stat-value">{uniqueVisitors.toLocaleString()}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Sessions</div>
        <div class="stat-value">{totalSessions.toLocaleString()}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Pages/Session</div>
        <div class="stat-value">{avgPagesPerSession.toFixed(1)}</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Bounce Rate</div>
        <div class="stat-value">{bounceRate.toFixed(1)}%</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Avg. Session</div>
        <div class="stat-value">{formatDuration(avgTimeOnSite)}</div>
      </div>
    </div>

    <div class="charts-row">
      <div class="chart-panel">
        <h3>Visits Over Time</h3>
        <div class="chart-container" id="visits-chart">
          <div class="simple-chart">
            {chartData.map(d => (
              <div class="chart-bar-container">
                <div
                  class="chart-bar"
                  style={`height: ${Math.max(4, (d.count / Math.max(...chartData.map(c => c.count))) * 100)}%`}
                  title={`${d.date}: ${d.count} visits`}
                />
                <span class="chart-label">{d.date.slice(5)}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="content-grid">
      <div class="panel">
        <h3>Top Pages</h3>
        <div class="panel-content">
          <table class="data-table">
            <thead>
              <tr>
                <th>Page</th>
                <th>Visits</th>
                <th>%</th>
              </tr>
            </thead>
            <tbody>
              {topPages.map(([path, count]) => (
                <tr>
                  <td class="page-path" title={path}>{path}</td>
                  <td>{count.toLocaleString()}</td>
                  <td>{((count / totalVisits) * 100).toFixed(1)}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="panel">
        <h3>Devices</h3>
        <div class="panel-content">
          <div class="breakdown-list">
            {Object.entries(visitsByDevice)
              .sort((a, b) => b[1] - a[1])
              .map(([device, count]) => (
                <div class="breakdown-item">
                  <span class="breakdown-label">{device}</span>
                  <div class="breakdown-bar-wrapper">
                    <div
                      class="breakdown-bar"
                      style={`width: ${(count / totalVisits) * 100}%`}
                    />
                  </div>
                  <span class="breakdown-value">{count.toLocaleString()}</span>
                </div>
              ))}
          </div>
        </div>
      </div>

      <div class="panel">
        <h3>Browsers</h3>
        <div class="panel-content">
          <div class="breakdown-list">
            {Object.entries(visitsByBrowser)
              .sort((a, b) => b[1] - a[1])
              .slice(0, 6)
              .map(([browser, count]) => (
                <div class="breakdown-item">
                  <span class="breakdown-label">{browser}</span>
                  <div class="breakdown-bar-wrapper">
                    <div
                      class="breakdown-bar"
                      style={`width: ${(count / totalVisits) * 100}%`}
                    />
                  </div>
                  <span class="breakdown-value">{count.toLocaleString()}</span>
                </div>
              ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  const rangeSelect = document.getElementById('range-select') as HTMLSelectElement;
  const countrySelect = document.getElementById('country-select') as HTMLSelectElement;
  const applyBtn = document.getElementById('apply-filters');

  applyBtn?.addEventListener('click', () => {
    const params = new URLSearchParams();
    params.set('range', rangeSelect.value);
    params.set('country', countrySelect.value);
    window.location.href = `/admin/analytics?${params.toString()}`;
  });
</script>

<style>
  .analytics-page {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .filters {
    display: flex;
    gap: 16px;
    align-items: flex-end;
    flex-wrap: wrap;
    background: #16202a;
    padding: 16px 20px;
    border-radius: 12px;
    border: 1px solid #2f3336;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .filter-group label {
    font-size: 0.75rem;
    color: #71767b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .filter-select {
    background: #0f1419;
    border: 1px solid #2f3336;
    border-radius: 6px;
    padding: 8px 12px;
    color: #e7e9ea;
    font-size: 0.875rem;
    min-width: 150px;
  }

  .filter-select:focus {
    outline: none;
    border-color: #1d9bf0;
  }

  .filter-btn {
    background: #1d9bf0;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .filter-btn:hover {
    background: #1a8cd8;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
  }

  .stat-card {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 12px;
    padding: 16px 20px;
  }

  .stat-label {
    font-size: 0.75rem;
    color: #71767b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: #e7e9ea;
  }

  .charts-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .chart-panel {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 12px;
    padding: 20px;
  }

  .chart-panel h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .chart-container {
    height: 200px;
  }

  .simple-chart {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 100%;
    gap: 4px;
    padding-bottom: 24px;
  }

  .chart-bar-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    max-width: 40px;
  }

  .chart-bar {
    width: 100%;
    background: linear-gradient(180deg, #1d9bf0 0%, #0d6ebd 100%);
    border-radius: 4px 4px 0 0;
    min-height: 4px;
    transition: opacity 0.15s ease;
    cursor: pointer;
  }

  .chart-bar:hover {
    opacity: 0.8;
  }

  .chart-label {
    font-size: 0.625rem;
    color: #71767b;
    margin-top: 4px;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .panel {
    background: #16202a;
    border: 1px solid #2f3336;
    border-radius: 12px;
    overflow: hidden;
  }

  .panel h3 {
    font-size: 1rem;
    font-weight: 600;
    padding: 16px 20px;
    border-bottom: 1px solid #2f3336;
  }

  .panel-content {
    padding: 16px 20px;
    max-height: 400px;
    overflow-y: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
  }

  .data-table th,
  .data-table td {
    text-align: left;
    padding: 8px;
    font-size: 0.8125rem;
  }

  .data-table th {
    color: #71767b;
    font-weight: 500;
    border-bottom: 1px solid #2f3336;
  }

  .data-table td {
    border-bottom: 1px solid #2f3336;
  }

  .data-table tr:last-child td {
    border-bottom: none;
  }

  .page-path {
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .breakdown-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .breakdown-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .breakdown-label {
    font-size: 0.8125rem;
    min-width: 80px;
    color: #e7e9ea;
  }

  .breakdown-bar-wrapper {
    flex: 1;
    height: 8px;
    background: #2f3336;
    border-radius: 4px;
    overflow: hidden;
  }

  .breakdown-bar {
    height: 100%;
    background: #1d9bf0;
    border-radius: 4px;
    min-width: 4px;
  }

  .breakdown-value {
    font-size: 0.8125rem;
    color: #71767b;
    min-width: 50px;
    text-align: right;
  }
</style>
