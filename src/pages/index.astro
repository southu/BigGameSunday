---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import LinkCard from '../components/LinkCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FeaturedImage from '../components/FeaturedImage.astro';

const sportsHubs = [
  { title: 'NFL Betting', href: '/nfl-betting', description: 'Point spreads, moneylines, totals, and market dynamics', icon: 'F' },
  { title: 'NBA Betting', href: '/nba-betting', description: 'Market efficiency, totals, props, and live betting', icon: 'B' },
  { title: 'College Football', href: '/college-football-betting', description: 'Volatile markets, big spreads, and bowl games', icon: 'C' },
  { title: 'College Basketball', href: '/college-basketball-betting', description: 'Pace, efficiency, and March Madness', icon: 'M' },
  { title: 'MLB Betting', href: '/mlb-betting', description: 'Pitching, line movement, and season-long discipline', icon: 'M' },
  { title: 'Big Games', href: '/big-games-tournaments', description: 'Super Bowl, playoffs, and championship events', icon: 'T' },
];

const foundationalGuides = [
  { title: 'Betting Strategy', href: '/betting-strategy', description: 'Expected value, bankroll management, and decision frameworks' },
  { title: 'Sportsbooks & Odds', href: '/sportsbooks-odds', description: 'How to evaluate books and shop for better prices' },
];

const featuredArticles = [
  {
    title: 'Understanding Betting Odds: A Complete Guide',
    href: '/blog/understanding-betting-odds',
    description: 'Learn how to read and interpret different odds formats and calculate implied probability.',
    category: 'Strategy',
    categoryHref: '/blog/category/strategy',
    image: 'https://images.pexels.com/photos/46798/the-ball-stadion-football-the-pitch-46798.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
  {
    title: 'Bankroll Management Fundamentals',
    href: '/blog/bankroll-management-fundamentals',
    description: 'Essential principles for protecting and growing your betting bankroll over time.',
    category: 'Strategy',
    categoryHref: '/blog/category/strategy',
    image: 'https://images.pexels.com/photos/6693661/pexels-photo-6693661.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
  {
    title: 'Line Shopping: Why It Matters',
    href: '/blog/line-shopping-why-it-matters',
    description: 'How comparing odds across sportsbooks can significantly impact your long-term results.',
    category: 'Sportsbooks',
    categoryHref: '/blog/category/sportsbooks',
    image: 'https://images.pexels.com/photos/3760067/pexels-photo-3760067.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
];
---

<Layout
  title="BigGameSunday"
  description="Sports betting education for serious sports fans who want to think more clearly about betting markets. Decision frameworks, risk awareness, and fundamentals that stay relevant."
>
  <Hero
    title="Smarter Sports Betting Through Clear Thinking"
    subtitle="BigGameSunday is sports betting education for serious sports fans who want to think more clearly about betting markets. We focus on decision-making frameworks, risk awareness, and fundamentals that stay relevant across seasons."
    size="large"
    align="left"
    image="/images/welcome-to-biggamesunday.png"
  />

  <div class="container">
    <section class="section intro-section">
      <div class="intro-content">
        <h2>Betting as a Decision Under Uncertainty</h2>
        <p>
          Sports betting is often presented as entertainment first and analysis second. BigGameSunday takes the opposite approach: we treat betting as a decision under uncertainty.
        </p>
        <div class="intro-points">
          <div class="intro-point">
            <h3>Understand Betting Markets</h3>
            <p>What lines mean, why they move, and what information is reflected in the price.</p>
          </div>
          <div class="intro-point">
            <h3>Make Better Decisions</h3>
            <p>Using repeatable frameworks rather than gut feel or recency bias.</p>
          </div>
          <div class="intro-point">
            <h3>Manage Risk</h3>
            <p>Practical bankroll and staking concepts that protect your decision quality.</p>
          </div>
          <div class="intro-point">
            <h3>Reduce Costly Habits</h3>
            <p>Avoid chasing losses, overreacting to short-term results, or betting out of boredom.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <div>
          <h2>Foundational Strategy Guides</h2>
          <p class="section-subtitle">Start with the core concepts: expected value, risk management, and how to evaluate a wager</p>
        </div>
      </div>
      <div class="foundation-grid">
        {foundationalGuides.map((guide) => (
          <a href={guide.href} class="foundation-card">
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
            <span class="foundation-link">Read the guide</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <div>
          <h2>Sport-Specific Guides</h2>
          <p class="section-subtitle">Different sports have different scoring structures, injury dynamics, and market behavior</p>
        </div>
      </div>
      <div class="sports-grid">
        {sportsHubs.map((sport) => (
          <LinkCard
            title={sport.title}
            href={sport.href}
            description={sport.description}
            icon={sport.icon}
          />
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Featured Content</h2>
        <a href="/blog" class="section-link">View all articles</a>
      </div>
      <div class="articles-grid">
        {featuredArticles.map((article, index) => (
          <ArticleCard
            title={article.title}
            href={article.href}
            description={article.description}
            category={article.category}
            categoryHref={article.categoryHref}
            image={article.image}
            featured={index === 0}
          />
        ))}
      </div>
    </section>

    <FeaturedImage
      src="https://images.pexels.com/photos/46798/the-ball-stadion-football-the-pitch-46798.jpeg?auto=compress&cs=tinysrgb&w=1200"
      alt="Football game action"
      caption="From NFL to March Madness, BigGameSunday covers all major sports betting markets"
      position="center"
    />

    <section class="section glossary-section">
      <h2>Common Sports Betting Terms</h2>
      <p class="glossary-intro">If you're learning, terminology shouldn't be a barrier. Here are quick definitions we use throughout the site.</p>
      <div class="glossary-grid">
        <div class="glossary-item">
          <dt>Implied Probability</dt>
          <dd>The probability suggested by the odds, before accounting for sportsbook margin.</dd>
        </div>
        <div class="glossary-item">
          <dt>Vig (Juice)</dt>
          <dd>The sportsbook's built-in margin on each bet.</dd>
        </div>
        <div class="glossary-item">
          <dt>Closing Line</dt>
          <dd>The final price/odds right before the game starts.</dd>
        </div>
        <div class="glossary-item">
          <dt>Line Movement</dt>
          <dd>Changes in the odds or point spread over time.</dd>
        </div>
        <div class="glossary-item">
          <dt>Spread</dt>
          <dd>A handicap applied to even out two teams.</dd>
        </div>
        <div class="glossary-item">
          <dt>Moneyline</dt>
          <dd>A bet on which team wins outright.</dd>
        </div>
        <div class="glossary-item">
          <dt>Total (Over/Under)</dt>
          <dd>A bet on combined points, runs, or goals scored.</dd>
        </div>
        <div class="glossary-item">
          <dt>Parlay</dt>
          <dd>Multiple bets linked together; all legs must win.</dd>
        </div>
      </div>
    </section>

    <section class="section cta-section">
      <div class="cta-content">
        <h2>Your Process Matters More Than Any Single Outcome</h2>
        <p>
          A smarter approach includes a clear reason for every bet, understanding implied probability, consistent staking that matches your risk tolerance, respect for variance, and a plan for when not to bet.
        </p>
        <div class="cta-links">
          <a href="/betting-strategy" class="cta-button">Start with Strategy</a>
          <a href="/about" class="cta-link">Learn about our approach</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .section {
    margin: var(--spacing-4xl) 0;
  }

  .intro-section {
    background-color: var(--color-surface);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-3xl);
    margin-top: var(--spacing-2xl);
  }

  .intro-content h2 {
    margin-bottom: var(--spacing-md);
    font-size: 1.75rem;
  }

  .intro-content > p {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 800px;
    margin-bottom: var(--spacing-xl);
  }

  .intro-points {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
  }

  .intro-point {
    padding: var(--spacing-md);
    border-left: 3px solid var(--color-accent-muted);
  }

  .intro-point h3 {
    font-size: 1rem;
    font-family: var(--font-body);
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
    color: var(--color-text);
  }

  .intro-point p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--spacing-xl);
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .section-header h2 {
    margin: 0;
    font-size: 1.75rem;
  }

  .section-subtitle {
    color: var(--color-text-secondary);
    margin: var(--spacing-xs) 0 0 0;
    font-size: 1rem;
  }

  .section-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }

  .section-link:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .foundation-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
  }

  .foundation-card {
    display: block;
    padding: var(--spacing-xl);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    text-decoration: none;
    transition: border-color var(--transition), background-color var(--transition);
  }

  .foundation-card:hover {
    border-color: var(--color-accent-muted);
    background-color: var(--color-surface-hover);
  }

  .foundation-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-text);
  }

  .foundation-card p {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    margin-bottom: var(--spacing-md);
    line-height: 1.5;
  }

  .foundation-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .sports-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
  }

  .glossary-section {
    background-color: var(--color-bg-secondary);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-3xl);
  }

  .glossary-section h2 {
    margin-bottom: var(--spacing-sm);
  }

  .glossary-intro {
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xl);
  }

  .glossary-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md) var(--spacing-xl);
  }

  .glossary-item {
    padding: var(--spacing-sm) 0;
  }

  .glossary-item dt {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
    margin-bottom: var(--spacing-xs);
  }

  .glossary-item dd {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .cta-section {
    background-color: var(--color-surface);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-3xl);
    text-align: center;
  }

  .cta-content {
    max-width: 650px;
    margin: 0 auto;
  }

  .cta-content h2 {
    margin-bottom: var(--spacing-md);
  }

  .cta-content p {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin-bottom: var(--spacing-xl);
  }

  .cta-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-block;
    padding: var(--spacing-sm) var(--spacing-xl);
    background-color: var(--color-accent);
    color: white;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: background-color var(--transition);
  }

  .cta-button:hover {
    background-color: var(--color-accent-hover);
    color: white;
  }

  .cta-link {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .cta-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .intro-points {
      grid-template-columns: 1fr;
    }

    .foundation-grid {
      grid-template-columns: 1fr;
    }

    .sports-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }

    .glossary-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .sports-grid {
      grid-template-columns: 1fr;
    }

    .intro-section,
    .glossary-section,
    .cta-section {
      padding: var(--spacing-2xl) var(--spacing-lg);
    }
  }
</style>
