---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import LinkCard from '../components/LinkCard.astro';
import ArticleCard from '../components/ArticleCard.astro';

const sportsHubs = [
  { title: 'NFL Betting', href: '/nfl-betting', description: 'Pro football analysis, trends, and betting strategies', icon: 'F' },
  { title: 'NBA Betting', href: '/nba-betting', description: 'Basketball betting insights and market analysis', icon: 'B' },
  { title: 'College Football', href: '/college-football-betting', description: 'CFB betting guides and conference breakdowns', icon: 'C' },
  { title: 'College Basketball', href: '/college-basketball-betting', description: 'March Madness and regular season coverage', icon: 'M' },
  { title: 'MLB Betting', href: '/mlb-betting', description: 'Baseball betting strategy and statistical analysis', icon: 'M' },
  { title: 'Big Games', href: '/big-games-tournaments', description: 'Super Bowl, playoffs, and championship events', icon: 'T' },
];

const featuredArticles = [
  {
    title: 'Understanding Betting Odds: A Complete Guide',
    href: '/blog/understanding-betting-odds',
    description: 'Learn how to read and interpret different odds formats and calculate implied probability.',
    category: 'Strategy',
    categoryHref: '/blog/category/strategy',
    image: 'https://images.pexels.com/photos/159745/football-american-football-team-sport-game-159745.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
  {
    title: 'Bankroll Management Fundamentals',
    href: '/blog/bankroll-management-fundamentals',
    description: 'Essential principles for protecting and growing your betting bankroll over time.',
    category: 'Strategy',
    categoryHref: '/blog/category/strategy',
    image: 'https://images.pexels.com/photos/6693661/pexels-photo-6693661.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
  {
    title: 'Line Shopping: Why It Matters',
    href: '/blog/line-shopping-why-it-matters',
    description: 'How comparing odds across sportsbooks can significantly impact your long-term results.',
    category: 'Sportsbooks',
    categoryHref: '/blog/category/sportsbooks',
    image: 'https://images.pexels.com/photos/3760067/pexels-photo-3760067.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
];
---

<Layout title="BigGameSunday" description="Sports betting education and analysis for smarter, more disciplined decisions around major sporting events.">
  <Hero
    title="Smarter Sports Betting Starts Here"
    subtitle="BigGameSunday provides in-depth analysis, proven strategies, and educational content to help you make more informed betting decisions."
    size="large"
    align="left"
  />

  <div class="container">
    <section class="section">
      <div class="section-header">
        <h2>Explore by Sport</h2>
        <p class="section-subtitle">Dive into sport-specific analysis, trends, and betting strategies</p>
      </div>
      <div class="sports-grid">
        {sportsHubs.map((sport) => (
          <LinkCard
            title={sport.title}
            href={sport.href}
            description={sport.description}
            icon={sport.icon}
          />
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Featured Content</h2>
        <a href="/blog" class="section-link">View all articles</a>
      </div>
      <div class="articles-grid">
        {featuredArticles.map((article, index) => (
          <ArticleCard
            title={article.title}
            href={article.href}
            description={article.description}
            category={article.category}
            categoryHref={article.categoryHref}
            image={article.image}
            featured={index === 0}
          />
        ))}
      </div>
    </section>

    <section class="section cta-section">
      <div class="cta-content">
        <h2>Build a Better Betting Approach</h2>
        <p>Whether you're new to sports betting or looking to refine your strategy, our educational resources can help you develop a more disciplined, analytical approach.</p>
        <div class="cta-links">
          <a href="/betting-strategy" class="cta-button">Explore Strategies</a>
          <a href="/about" class="cta-link">Learn about our approach</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .section {
    margin: var(--spacing-4xl) 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--spacing-xl);
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .section-header h2 {
    margin: 0;
    font-size: 1.75rem;
  }

  .section-subtitle {
    color: var(--color-text-secondary);
    margin: var(--spacing-xs) 0 0 0;
    font-size: 1rem;
  }

  .section-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }

  .section-link:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .sports-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
  }

  .cta-section {
    background-color: var(--color-surface);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-3xl);
    text-align: center;
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-content h2 {
    margin-bottom: var(--spacing-md);
  }

  .cta-content p {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin-bottom: var(--spacing-xl);
  }

  .cta-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-block;
    padding: var(--spacing-sm) var(--spacing-xl);
    background-color: var(--color-accent);
    color: white;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    border-radius: var(--border-radius);
    transition: background-color var(--transition);
  }

  .cta-button:hover {
    background-color: var(--color-accent-hover);
    color: white;
  }

  .cta-link {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .cta-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .sports-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .sports-grid {
      grid-template-columns: 1fr;
    }

    .cta-section {
      padding: var(--spacing-2xl) var(--spacing-lg);
    }
  }
</style>
