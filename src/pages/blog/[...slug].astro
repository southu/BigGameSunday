---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TagList from '../../components/TagList.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const tags = post.data.tags.map(tag => ({
  name: tag,
  href: `/blog/tag/${tag}`,
}));
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.image}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  author={post.data.author}
>
  <article class="article">
    {post.data.image && (
      <div class="article-hero">
        <img src={post.data.image} alt={post.data.imageAlt || post.data.title} class="article-hero-image" />
        <div class="article-hero-overlay"></div>
      </div>
    )}

    <div class="container">
      <header class="article-header">
        <div class="article-meta">
          <a href={`/blog/category/${post.data.category}`} class="article-category">
            {post.data.category}
          </a>
          <time datetime={post.data.pubDate.toISOString()} class="article-date">
            {formattedDate}
          </time>
        </div>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-description">{post.data.description}</p>
        {tags.length > 0 && <TagList tags={tags} />}
      </header>

      <div class="article-content">
        <Content />
      </div>

      {relatedPosts.length > 0 && (
        <aside class="related-posts">
          <h2 class="related-title">Related Articles</h2>
          <div class="related-grid">
            {relatedPosts.map((relatedPost) => (
              <ArticleCard
                title={relatedPost.data.title}
                href={`/blog/${relatedPost.id}`}
                description={relatedPost.data.description}
                date={relatedPost.data.pubDate}
                category={relatedPost.data.category}
                categoryHref={`/blog/category/${relatedPost.data.category}`}
                image={relatedPost.data.image}
                imageAlt={relatedPost.data.imageAlt}
              />
            ))}
          </div>
        </aside>
      )}

      <nav class="article-nav">
        <a href="/blog" class="back-link">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to all articles
        </a>
      </nav>
    </div>
  </article>
</Layout>

<style>
  .article {
    padding-bottom: var(--spacing-4xl);
  }

  .article-hero {
    position: relative;
    height: 400px;
    margin-bottom: var(--spacing-3xl);
    overflow: hidden;
  }

  .article-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 0%, var(--color-bg) 100%);
  }

  .article-header {
    max-width: var(--max-width-content);
    margin-bottom: var(--spacing-3xl);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .article-category {
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .article-category:hover {
    color: var(--color-accent-hover);
  }

  .article-date {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .article-title {
    font-size: 2.5rem;
    line-height: 1.15;
    margin-bottom: var(--spacing-md);
  }

  .article-description {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: var(--spacing-lg);
  }

  .article-content {
    max-width: var(--max-width-content);
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .article-content :global(h2) {
    color: var(--color-text);
    font-size: 1.75rem;
    margin-top: var(--spacing-3xl);
    margin-bottom: var(--spacing-md);
  }

  .article-content :global(h3) {
    color: var(--color-text);
    font-size: 1.35rem;
    margin-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-md);
  }

  .article-content :global(p) {
    margin-bottom: var(--spacing-md);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: var(--spacing-md);
    padding-left: var(--spacing-xl);
  }

  .article-content :global(li) {
    margin-bottom: var(--spacing-xs);
  }

  .article-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-content :global(a:hover) {
    color: var(--color-accent-hover);
  }

  .article-content :global(blockquote) {
    margin: var(--spacing-xl) 0;
    padding: var(--spacing-md) var(--spacing-lg);
    border-left: 4px solid var(--color-accent-muted);
    background-color: var(--color-surface);
    border-radius: 0 var(--border-radius) var(--border-radius) 0;
    font-style: italic;
  }

  .related-posts {
    max-width: var(--max-width-content);
    margin-top: var(--spacing-4xl);
    padding-top: var(--spacing-2xl);
    border-top: 1px solid var(--color-border);
  }

  .related-title {
    font-size: 1.35rem;
    margin-bottom: var(--spacing-lg);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
  }

  .article-nav {
    max-width: var(--max-width-content);
    margin-top: var(--spacing-3xl);
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .article-hero {
      height: 280px;
    }

    .article-title {
      font-size: 1.85rem;
    }

    .article-description {
      font-size: 1.1rem;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
